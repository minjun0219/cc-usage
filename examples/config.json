{
  "config_dir": "~/.claude",
  "source": "stdin",
  "alert_percent": 90,
  "badges": {
    "work@example.com": {
      "emoji": "🏢"
    },
    "me@example.com": {
      "color": "blue",
      "glyph": "◆"
    }
  },
  "guard": false,
  "extra_commands": [
    {
      "command": [
        "my-statusline-tool",
        "line",
        "-s",
        "{{session_id}}"
      ]
    },
    {
      "command": [
        "curl",
        "-sf",
        "--get",
        "--data-urlencode",
        "cwd={{cwd}}",
        "--data-urlencode",
        "session={{session_id}}",
        "http://127.0.0.1:PORT/api/statusline"
      ],
      "timeout_ms": 300
    }
  ]
}
