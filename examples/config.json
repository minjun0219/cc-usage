{
  "config_dir": "~/.claude",
  "source": "stdin",
  "alert_percent": 90,
  "guard": false,
  "extra_commands": [
    {
      "command": ["my-statusline-tool", "line", "-s", "{{session_id}}"]
    },
    {
      "command": [
        "curl",
        "-sf",
        "--get",
        "--data-urlencode",
        "cwd={{cwd}}",
        "--data-urlencode",
        "session={{session_id}}",
        "http://127.0.0.1:PORT/api/statusline"
      ],
      "timeout_ms": 300
    }
  ],
  "notify": {
    "enabled": true,
    "command": [
      "osascript",
      "-e",
      "display notification \"{{message}}\" with title \"Claude 한도\" subtitle \"{{window}} {{percent}}%\""
    ]
  }
}
