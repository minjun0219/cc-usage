{
  "$schema": "https://raw.githubusercontent.com/minjun0219/cc-usage/main/config.schema.json",
  "configDir": "~/.claude",
  "source": "stdin",
  "alertPercent": 90,
  "badges": {
    "work@example.com": {
      "emoji": "🏢"
    },
    "me@example.com": {
      "color": "blue",
      "glyph": "◆"
    }
  },
  "guard": false,
  "extraCommands": [
    {
      "command": [
        "my-statusline-tool",
        "line",
        "-s",
        "{{session_id}}"
      ]
    },
    {
      "command": [
        "curl",
        "-sf",
        "--get",
        "--data-urlencode",
        "cwd={{cwd}}",
        "--data-urlencode",
        "session={{session_id}}",
        "http://127.0.0.1:PORT/statusline"
      ],
      "timeoutMs": 300
    }
  ]
}
